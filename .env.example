# PostgreSQL connection string (same setup as csinitte/csi-site).
# When unset in local development or tests, the app automatically falls back
# to an embedded PGlite database under .data/pglite (or in-memory during tests).
DATABASE_URL=postgres://user:password@host:5432/database
DATABASE_POOL_MAX=3

# Optional override for database driver: "postgres" | "pglite"
# NEXUS_DB_DRIVER=postgres
# NEXUS_PGLITE_DATA_DIR=.data/pglite

# Private S3-compatible object storage for Project Expo abstract PDFs.
# Abstracts are private and served only through authenticated admin endpoints.
# When S3_BUCKET is unset in local development, abstracts are stored in .data/abstracts/.
S3_REGION=auto
S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
S3_BUCKET=csi-uploads
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key

# Maximum abstract upload size in bytes (default: 10485760 = 10 MB)
NEXUS_MAX_ABSTRACT_BYTES=10485760

# Brevo / SMTP configuration for college registration confirmation emails
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user_email
BREVO_SMTP_PASS=your_brevo_smtp_password
MAIL_FROM="CSI NMAMIT" <csi.nmamit@nitte.edu.in>

# Official NEXUS 2026 WhatsApp group link included in confirmation response & email
WHATSAPP_COMMUNITY_LINK=https://chat.whatsapp.com/your_nexus_2026_invite_code

# Server-only admin bootstrap & session signing credentials (never prefix with NEXT_PUBLIC_)
NEXUS_ADMIN_EMAIL=csi.nmamit@nitte.edu.in
NEXUS_ADMIN_PASSWORD=change-me-strong-password
NEXUS_ADMIN_NAME="NEXUS 2026 Admin"
NEXUS_SESSION_SECRET=change-me-32-byte-minimum-session-secret

# Public origin for signed confirmation summary links in email
NEXUS_PUBLIC_URL=http://localhost:3000
